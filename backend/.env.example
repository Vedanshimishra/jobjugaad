# Copy to backend/.env. ANTHROPIC_API_KEY is read by the Anthropic SDK directly.
ANTHROPIC_API_KEY=

# Optional overrides (prefix JOBJUGAAD_)
# JOBJUGAAD_DATABASE_URL=postgresql+psycopg://user:pass@localhost/jobjugaad
# JOBJUGAAD_LLM_MODEL=claude-opus-5-5
# JOBJUGAAD_LLM_EFFORT_AGENT=high
# JOBJUGAAD_LLM_EFFORT_TASKS=medium
# JOBJUGAAD_AGENT_MAX_STEPS=25

# Public job boards to search (comma-separated board tokens)
# JOBJUGAAD_GREENHOUSE_BOARDS=anthropic,stripe,databricks,figma,discord,robinhood
# JOBJUGAAD_LEVER_COMPANIES=palantir
# JOBJUGAAD_ASHBY_BOARDS=openai,ramp,notion,linear

# Optional: send approved emails via SMTP (otherwise approved messages are copied and sent manually)
# JOBJUGAAD_SMTP_HOST=smtp.gmail.com
# JOBJUGAAD_SMTP_PORT=587
# JOBJUGAAD_SMTP_USER=
# JOBJUGAAD_SMTP_PASSWORD=
# JOBJUGAAD_SMTP_FROM=
